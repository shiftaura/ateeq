# Environment
NODE_ENV=development
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mediconsult?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/mediconsult
MONGO_URI=mongodb://127.0.0.1:27017/mediconsult

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
